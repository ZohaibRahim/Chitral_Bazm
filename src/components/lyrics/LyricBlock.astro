---
// The lyric reader (T-09). Static HTML + CSS only: no React, no Motion, no hydration (CLAUDE.md, D-06).
//
// Layer controls are plain checkboxes; CSS :has() hides unchecked layers *visually* while keeping them in the
// accessibility tree (PRD §8: Khowar has no screen-reader voice, so Roman/English must stay readable).
// Default (D-04): Khowar + popular Roman; English off.
// Without :has() support, every layer is shown and the controls are hidden, so no content is ever lost.
import type { Song } from "../../lib/content/schemas";
import LyricLine from "./LyricLine.astro";

interface Props {
  song: Song;
}
const { song } = Astro.props;
const lines = song.stanzas.flatMap((s) => s.lines);
const hasRoman = lines.some((l) => l.renderings.roman_popular !== undefined);
const hasEnglish = lines.some((l) => l.renderings.en !== undefined);
const urduDigits = (n: number) => String(n).replace(/\d/g, (d) => String.fromCharCode(0x06f0 + Number(d)));
---

<section class="lyrics" aria-labelledby="lyrics-heading">
  <h2 id="lyrics-heading" class="visually-hidden">Lyrics</h2>
  {
    (hasRoman || hasEnglish) && (
      <fieldset class="layer-controls">
        <legend>Show under each line</legend>
        {hasRoman && (
          <label>
            <input type="checkbox" id="show-roman" checked /> Roman Khowar
          </label>
        )}
        {hasEnglish && (
          <label>
            <input type="checkbox" id="show-en" /> English
          </label>
        )}
      </fieldset>
    )
  }
  {
    song.stanzas.map((stanza) => (
      <section class="stanza" aria-label={`Stanza ${stanza.n}`} data-stanza={stanza.n}>
        <p class="stanza-number" lang="ur" dir="rtl" aria-hidden="true">
          {urduDigits(stanza.n)}
        </p>
        <ol class="lines">
          {stanza.lines.map((line) => (
            <LyricLine line={line} />
          ))}
        </ol>
      </section>
    ))
  }
</section>

<style>
  .lyrics {
    max-width: var(--measure);
    margin-inline: auto;
    text-align: center; /* verse is centred, as Khowar/Urdu poetry is conventionally set */
  }

  .layer-controls {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin: 0 0 2.5rem;
    padding: 0;
    border: 0;
    font-family: var(--font-ui);
    font-size: 0.9rem;
  }
  .layer-controls legend {
    width: 100%;
    margin-bottom: 0.5rem;
    padding: 0;
    color: var(--text-gloss);
    font-size: 0.85rem;
  }
  .layer-controls label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem; /* 44 px touch target */
    padding: 0 1rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--surface-raised);
    color: var(--text);
    cursor: pointer;
  }
  .layer-controls input {
    width: 1.1rem;
    height: 1.1rem;
    margin: 0;
    accent-color: var(--accent);
  }
  .layer-controls label:hover {
    border-color: var(--text-roman);
  }
  .layer-controls label:has(input:checked) {
    border-color: var(--accent);
  }
  .layer-controls label:has(input:focus-visible) {
    box-shadow: var(--focus-ring);
  }

  .stanza + .stanza {
    margin-top: var(--space-stanza);
  }
  .stanza-number {
    margin: 0 0 0.75rem;
    color: var(--accent);
    font-size: 1.25rem;
    line-height: 1.6;
  }
  .lines {
    margin: 0;
    padding: 0;
    list-style: none;
  }


  /* Controls only where :has() exists; otherwise everything stays visible. */
  @supports not selector(:has(*)) {
    .layer-controls {
      display: none;
    }
  }
  @supports selector(:has(*)) {
    .lyrics:has(#show-roman:not(:checked)) :global(.layer-roman),
    .lyrics:has(#show-en:not(:checked)) :global(.layer-en) {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
