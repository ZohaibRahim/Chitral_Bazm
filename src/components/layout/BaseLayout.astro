---
// Site shell (T-08). Static: no islands. Song pages ship zero JavaScript (D-06).
import "../../styles/tokens.css";
import "../../styles/base.css";
import "../../styles/khowar.css";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";

interface Props {
  title: string;
  description?: string;
  /** noindex for development, preview, synthetic and placeholder pages. */
  noindex?: boolean;
  /** Preload the Khowar webfont (song pages only, PRD §8). */
  preloadKhowarFont?: boolean;
}

const { title, description, noindex = false, preloadKhowarFont = false } = Astro.props;
const fullTitle = title === "Khowar Lyrics Archive" ? title : `${title} · Khowar Lyrics Archive`;
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f7f4" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {
      preloadKhowarFont && (
        <link rel="preload" href="/fonts/noto-nastaliq-urdu-v3.009-regular.woff2" as="font" type="font/woff2" crossorigin />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  main {
    flex: 1;
    width: 100%;
    max-width: 48rem;
    margin-inline: auto;
    padding: 1.5rem var(--gutter) 4rem;
    box-sizing: border-box;
  }
  main:focus {
    outline: none;
  }
</style>
