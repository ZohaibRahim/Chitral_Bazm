---
// Plain links; works without JavaScript on every page (D-06). Routes /songs/, /search/ and /about/ arrive in
// T-22, T-11 and T-23.
const links = [
  { href: "/songs/", label: "Songs" },
  { href: "/search/", label: "Search" },
  { href: "/about/", label: "About" },
];
const path = Astro.url.pathname;
---

<header class="site-header">
  <a class="wordmark" href="/" translate="no">Khowar Lyrics <span>Archive</span></a>
  <nav aria-label="Main">
    <ul>
      {
        links.map((l) => (
          <li>
            <a href={l.href} aria-current={path.startsWith(l.href) ? "page" : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    max-width: 48rem;
    width: 100%;
    margin-inline: auto;
    padding: 1rem var(--gutter) 0.75rem;
    box-sizing: border-box;
    border-bottom: 1px solid var(--rule);
  }
  .wordmark {
    font-family: var(--font-reading);
    font-size: 1.25rem;
    color: var(--text);
    text-decoration: none;
    letter-spacing: 0.01em;
  }
  .wordmark span {
    font-style: italic;
    color: var(--accent);
  }
  ul {
    display: flex;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    display: inline-block;
    padding-block: 0.6rem; /* >= 44 px touch target with line-height */
    color: var(--text);
    text-decoration: none;
    font-size: 0.95rem;
  }
  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--accent);
    text-decoration: underline;
  }
</style>
