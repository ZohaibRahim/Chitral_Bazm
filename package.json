{
  "name": "khowar-lyrics-archive",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Khowar Lyrics Archive: static-first archive of Khowar song lyrics with Roman and English layers.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build --force",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:install": "playwright install chromium",
    "lhci": "lhci autorun",
    "ci": "npm run typecheck && npm run test && npm run test:build && npm run build && npm run e2e",
    "test:build": "vitest run --config vitest.build.config.ts",
    "e2e": "playwright test --project=site",
    "fonts:fetch": "node scripts/fonts/py.mjs scripts/fonts/fetch_fonts.py",
    "fonts:check": "node scripts/fonts/py.mjs scripts/fonts/check_fonts.py",
    "fonts:test": "node scripts/fonts/py.mjs -m unittest discover -s scripts/fonts -p test_*.py",
    "fonts:page": "node scripts/fonts/py.mjs scripts/fonts/build_test_page.py",
    "fonts:serve": "node scripts/fonts/serve.mjs",
    "fonts:e2e": "playwright test --project=fonts"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "motion": "^14.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "yaml": "2.9.1"
  }
}
